{
  "name": "codearchitect-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "graph:self": "node scripts/build-self-graph.mjs . public/samples/codearchitect-self.graph.json",
    "test:live": "vitest run --config vitest.live.config.ts",
    "models": "node scripts/list-models.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "ext:build": "node scripts/build-extension.mjs",
    "ext:package": "npm run ext:build --silent && cd extensions/vscode && npx --yes @vscode/vsce package --no-dependencies --skip-license --allow-missing-repository -o codearchitect.vsix",
    "view": "npm run build:cli --silent && node dist/cli/codearchitect.mjs view",
    "cli": "npm run build:cli --silent && node dist/cli/codearchitect.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
