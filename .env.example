# All optional. With nothing set, the deterministic local engine does all analysis.

# --- Pick a provider -------------------------------------------------------
# anthropic | openai | gemini | ollama | lmstudio | openrouter | groq | deepseek | custom
# Leave empty to auto-detect from whichever provider key below is set.
AI_PROVIDER=
# Required for every provider except anthropic (default claude-opus-5-5).
AI_MODEL=

# --- Keys (only the one for your provider) --------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Overrides the provider-specific key variable above.
AI_API_KEY=

# --- Advanced ------------------------------------------------------------------
# Any OpenAI-compatible endpoint (overrides the preset; required for AI_PROVIDER=custom).
AI_BASE_URL=
# Characters of source sent per request; presets default to the model class's window.
AI_MAX_INPUT_CHARS=
# auto (default) | local (never call a model)
CODEARCHITECT_ENGINE=auto
# Raises GitHub's rate limit for repository URL imports.
GITHUB_TOKEN=

# --- Example: free local models with Ollama (https://ollama.com) -------------
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5-coder:14b
