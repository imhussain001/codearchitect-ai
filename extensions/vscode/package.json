{
  "name": "codearchitect-vscode",
  "displayName": "CodeArchitect: Blast Radius",
  "description": "See what a change to this file can break: dependents in the status bar, per-symbol usage CodeLens, and a shareable architecture page.",
  "version": "0.1.0",
  "publisher": "imhussain001",
  "license": "Apache-2.0",
  "author": {
    "name": "Hussain Tak",
    "url": "https://github.com/imhussain001"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "architecture",
    "dependencies",
    "blast radius",
    "impact analysis"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codearchitect.showGraph",
        "title": "CodeArchitect: Show architecture map",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codearchitect.showBlastRadius",
        "title": "CodeArchitect: Show blast radius of this file"
      },
      {
        "command": "codearchitect.showUsers",
        "title": "CodeArchitect: Who uses this symbol?"
      },
      {
        "command": "codearchitect.exportShare",
        "title": "CodeArchitect: Export shareable architecture page"
      },
      {
        "command": "codearchitect.refresh",
        "title": "CodeArchitect: Re-map the workspace"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codearchitect.showGraph",
          "group": "navigation",
          "when": "config.codearchitect.showTitleBarButton && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact|go|java|rust|python|matlab)$/"
        }
      ]
    },
    "configuration": {
      "title": "CodeArchitect",
      "properties": {
        "codearchitect.statusBarClick": {
          "type": "string",
          "enum": [
            "list",
            "map"
          ],
          "enumDescriptions": [
            "Clicking \"N files affected\" shows the list of affected files.",
            "Clicking \"N files affected\" opens the architecture map beside the code."
          ],
          "default": "list",
          "description": "What clicking the status bar item does. The other one stays available from the Command Palette."
        },
        "codearchitect.showTitleBarButton": {
          "type": "boolean",
          "default": false,
          "description": "Show a button in the editor's title bar (top right) that opens the architecture map."
        },
        "codearchitect.maxFiles": {
          "type": "number",
          "default": 800,
          "minimum": 20,
          "description": "Most files to map. Bigger workspaces map the most architecturally relevant files and the status bar says how many were left out."
        },
        "codearchitect.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show \"used by N files\" above exported symbols."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imhussain001/codearchitect-ai.git",
    "directory": "extensions/vscode"
  }
}
